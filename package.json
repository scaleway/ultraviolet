{
  "name": "root",
  "private": true,
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "scripts": {
    "preinstall": "git config --local include.path $PWD/.gitconfig || true",
    "analyse:deps:form": "node ./utils/scripts/analyse-deps.ts packages/form/src/components",
    "analyse:deps:ui": "node ./utils/scripts/analyse-deps.ts packages/ui/src/components",
    "analyse:dist": "node ./utils/scripts/compare/compare-dist-migration.ts",
    "build": "turbo run build --filter='./packages/*' ",
    "build:examples": "turbo run build --filter './examples/*' ",
    "build:storybook": "STORYBOOK_ENVIRONMENT=production storybook build",
    "build:storybook:stats": "pnpm turbo build:storybook -- --webpack-stats-json",
    "check:deps": "npx depcheck . --skip-missing=true --ignores='vite,@commitlint/*'",
    "commit": "npx git-cz -a --disable-emoji",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "icons:update": "pnpm run svg:icons && tsx ./utils/scripts/generate-icons-file.tsx && pnpm run format packages/icons",
    "illustrations:update": "BUCKET_NAME=scaleway-assets BUCKET_REGION=fr-par && pnpm run svg:illustrations && tsx utils/scripts/illustrations/update-illustrations.tsx && pnpm format packages/illustrations/src/",
    "lintpublish": "turbo run lintpublish",
    "lint": "oxlint -c .oxlintrc.jsonc",
    "lint:fix": "pnpm run lint --fix",
    "release": "pnpm build && pnpm changeset publish",
    "size": "turbo run size",
    "start": "STORYBOOK_ENVIRONMENT=development storybook dev -p 6006",
    "start:production": "STORYBOOK_ENVIRONMENT=production storybook dev -p 6006",
    "svg": "svgo --config=./svgo.config.mjs --pretty --multipass",
    "svg:illustrations": "pnpm run svg -r -f 'packages/illustrations/src/assets'",
    "svg:icons": "pnpm run svg -r -f 'packages/icons/src/components'",
    "svg:all": "pnpm run svg:icons && pnpm run svg:illustrations",
    "test:e2e": "turbo e2e --filter @repo/e2e",
    "test:unit": "turbo run test:unit",
    "test:unit:coverage": "turbo run test:unit:coverage",
    "tokens:update": "node ./utils/scripts/figma-synchronise-token/index.ts && pnpm run format packages/themes/src/themes/console",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@manypkg/cli": "0.25.1",
    "@playwright/test": "1.62.1",
    "@scaleway/oxfmt-config": "1.1.4",
    "@scaleway/oxlint-config": "0.2.3",
    "@scaleway/tsconfig": "1.1.6",
    "@size-limit/file": "13.0.3",
    "@size-limit/preset-big-lib": "13.0.3",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-links": "10.5.7",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/builder-vite": "10.5.7",
    "@storybook/mdx2-csf": "1.1.0",
    "@storybook/react-vite": "10.5.7",
    "@svgr/rollup": "8.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/zxcvbn": "4.4.5",
    "@ultraviolet/fonts": "workspace:*",
    "@ultraviolet/themes": "workspace:*",
    "@ultraviolet/ui": "workspace:*",
    "@vanilla-extract/css": "1.21.2",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "browserslist": "4.28.7",
    "cz-conventional-changelog": "3.3.0",
    "date-fns": "4.4.0",
    "file-loader": "6.2.0",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.26",
    "publint": "0.3.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-scan": "0.5.7",
    "read-pkg": "10.1.0",
    "regenerator-runtime": "0.14.1",
    "remark-gfm": "4.0.1",
    "rollup-preserve-directives": "1.1.3",
    "size-limit": "13.0.3",
    "storybook": "10.5.7",
    "storybook-addon-tag-badges": "3.1.0",
    "svgo": "4.0.2",
    "turbo": "2.10.9",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "0.1.0",
    "vitest-canvas-mock": "1.1.4",
    "vitest-localstorage-mock": "0.1.2",
    "wcag-guidelines-mcp": "2.0.0",
    "zxcvbn": "4.4.2"
  },
  "lint-staged": {
    "*.(j|t|mj)s?(x)": [
      "pnpm run format",
      "pnpm run lint --no-error-on-unmatched-pattern"
    ],
    "packages/illustrations/**/*.svg": [
      "pnpm run svg"
    ],
    "*.y?(a)ml": [
      "pnpm run format"
    ],
    "*.json?(c)": [
      "pnpm run format"
    ],
    ".md?(x)": [
      "pnpm run format"
    ],
    "pnpm-lock.yaml, package.json, **/pnpm-lock.yaml, **/package.json": [
      "pnpm exec manypkg check"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.0 || 26.x",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=20.x",
    "pnpm": ">=10.x"
  },
  "manypkg": {
    "ignoredRules": [
      "INTERNAL_MISMATCH"
    ]
  }
}
